# Keep "false" until launch day. While false, robots.txt blocks all crawlers,
# every page gets <meta name="robots" content="noindex, nofollow">, and the
# sitemap is not advertised in robots.txt. Set to "true" in Vercel's
# Production environment only when the site is ready to be indexed.
NEXT_PUBLIC_SITE_LIVE=false

# Booking form email (src/app/api/book/route.ts). Without RESEND_API_KEY the
# route logs each request to the server console instead of sending it.
RESEND_API_KEY=
# CONFIRM: Jay's inbox for ride requests. Defaults to site.email when blank.
BOOKING_TO_EMAIL=
# CONFIRM: must be on a domain verified in Resend, e.g. "Northline Bookings <bookings@northlinewheelchair.com>".
BOOKING_FROM_EMAIL=

# Lead store (src/lib/leads.ts): every form submission is stored as well as
# emailed. Add Upstash Redis from the Vercel Marketplace; it sets these (or the
# KV_REST_API_URL / KV_REST_API_TOKEN pair, which also works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# With NEXT_PUBLIC_SITE_LIVE=true the build FAILS unless RESEND_API_KEY,
# BOOKING_TO_EMAIL, BOOKING_FROM_EMAIL and the lead store are all set, and the
# site.ts phone/address are real (scripts/check-launch.ts). In production
# (VERCEL_ENV=production) a form that can't deliver answers 503 with the phone.
